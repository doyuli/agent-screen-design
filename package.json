{
  "name": "nuxt-starter",
  "type": "module",
  "private": true,
  "scripts": {
    "release": "bumpp",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postinstall": "nuxt prepare && simple-git-hooks"
  },
  "dependencies": {
    "@lucide/vue": "^1.23.0",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "nuxt": "^4.4.8",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.39",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.1.0",
    "vue3-moveable": "^0.28.0",
    "vue3-selecto": "^1.12.3",
    "vue3-sketch-ruler": "^2.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@pinia/nuxt": "0.11.3",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@vueuse/nuxt": "14.3.0",
    "bumpp": "^11.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^17.0.8",
    "picocolors": "^1.1.1",
    "shadcn-nuxt": "2.7.4",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "node scripts/verify-commit.js"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
